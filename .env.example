# Port the web UI will be exposed on (host side)
APP_PORT=8080

# 32-character secret keys / session secret - setup.sh / setup.ps1 generate
# these for you.
APP_SECRET_KEY=
GUAC_CRYPT_KEY=
SESSION_SECRET=

# Optional. Only set this to "true" if this app is genuinely running
# behind a trusted reverse proxy (e.g. Traefik, nginx). It tells the app to
# trust the X-Forwarded-For header for determining the real client IP
# (used by rate limiting and the audit log). Leave unset/false if you're
# accessing this app directly - trusting that header without an actual
# proxy in front would let anyone spoof their own IP.
TRUST_PROXY=
